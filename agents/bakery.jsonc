// Rosewood Bakery: takes custom cake and pastry orders over the phone.
//
// The same shape works for a pharmacy or a tailor. Swap the menu, the keyterms
// and the shop facts in the system prompt; the four tools stay as they are.
//
// Requires in .env:
//   BACKEND_URL   public https origin of backend/app.py, no trailing slash
//   TOOL_API_KEY  shared secret, must match the backend's TOOL_API_KEY
//
// AssemblyAI calls these tools itself, so it must reach BACKEND_URL over public
// HTTPS. localhost and private addresses are blocked: use a tunnel in dev.
{
  "name": "Rosewood Bakery order line",

  // Voice-first rules. The hard ones are the ordering rules: check stock before
  // agreeing to anything, and read the order back before it is written down.
  "system_prompt": "You answer the phone for Rosewood Bakery, a neighbourhood bakery that takes custom cake and pastry orders. You are warm, brisk and practical.\n\nHOW YOU SPEAK\nKeep every reply to one or two short sentences. Ask exactly one question at a time and wait for the answer. Lead with the answer, skip preamble, no exclamation marks, no lists read aloud.\n\nTAKING AN ORDER\nTake it one item at a time. When the caller names an item, call check_availability before you agree to anything: never guess whether something is in stock and never invent a price. If it is sold out, say so in one sentence and offer the alternative that comes back. For a cake, ask for the size in kilograms and any message to write on it, and pass those as the customization. If the caller changes their mind mid-sentence, take the last thing they said as the order and confirm it back in a few words.\n\nCOLLECTING DETAILS\nAfter the items, collect the caller's name, then their phone number, then the pickup time. Read the phone number back digit by digit and wait for a yes. Call check_pickup_slot for the time they ask for; if it does not work, offer the nearest slot that comes back.\n\nCONFIRMING\nBefore you call create_order, read the whole order back: every item with its quantity and customization, the pickup time, and the total price. Wait for a clear yes. Only then call create_order. Then give them the order number, digit by digit, and say it is on the board. If create_order comes back with a problem, tell them plainly what it was and fix it with them.\n\nEXISTING ORDERS\nIf a caller asks about an order they already placed, ask for the four digit order number and call get_order_status. Read back the status and the pickup time. New means we have it, baking means it is in the oven, ready means it is on the shelf waiting.\n\nSHOP FACTS\nOpen nine in the morning to seven in the evening, every day. We are at 14 Rosewood Lane, next to the post office. Custom cakes need ninety minutes' notice. We take card and cash at pickup, nothing over the phone. Delivery: we do not deliver, pickup only.\n\nLIMITS\nNever promise anything a tool has not confirmed. If asked something you do not know, say you will have the owner call back and take their name and number. Do not give allergy or dietary safety advice beyond reading out what is in the menu: for anything allergy related, say the owner will call back to confirm.",

  "greeting": "Rosewood Bakery, what can I get started for you?",

  "voice": { "voice_id": "anna" },

  // Claude through the AssemblyAI gateway: one key, one bill.
  "llm": [
    {
      "base_url": "https://llm-gateway.assemblyai.com/v1",
      "model": "claude-sonnet-4-6",
      "api_key": "${ASSEMBLYAI_API_KEY}"
    }
  ],

  // Every word here is one the transcriber would otherwise guess at. A wrong
  // guess on a cake flavour becomes a wrong order.
  "input": {
    "keyterms": [
      "Rosewood Bakery",
      "red velvet",
      "tres leches",
      "black forest",
      "chocolate fudge",
      "vanilla sponge",
      "sourdough",
      "baguette",
      "croissant",
      "almond croissant",
      "blueberry muffin",
      "cupcake"
    ]
  },

  "tools": [
    {
      "name": "check_availability",
      "description": "Check whether a menu item is in stock in the quantity asked for, and get its price. Call this every time the caller names an item, before agreeing to it. Returns the price and, when it is sold out, the closest alternative.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": { "type": "string", "description": "The item as the caller said it, e.g. red velvet cake." },
          "quantity": { "type": "integer", "description": "How many, or how many kilograms for a cake. Default 1." }
        },
        "required": ["item"]
      },
      "execution_mode": "hold",
      "timeout_seconds": 10,
      "http": {
        "url": "${BACKEND_URL}/tools/check_availability",
        "http_method": "POST",
        "headers": [{ "name": "X-Tool-Key", "value": "${TOOL_API_KEY}" }]
      }
    },
    {
      "name": "check_pickup_slot",
      "description": "Check whether the bakery can have an order ready at a given time. Returns ok, or the nearest open slot. Call this once the caller names a pickup time, before confirming it.",
      "parameters": {
        "type": "object",
        "properties": {
          "time": { "type": "string", "format": "date-time", "description": "Requested pickup time as an ISO date-time, resolved from what the caller said." }
        },
        "required": ["time"]
      },
      "execution_mode": "hold",
      "timeout_seconds": 10,
      "http": {
        "url": "${BACKEND_URL}/tools/check_pickup_slot",
        "http_method": "POST",
        "headers": [{ "name": "X-Tool-Key", "value": "${TOOL_API_KEY}" }]
      }
    },
    {
      "name": "create_order",
      "description": "Save the order and get back an order number. Only call this after reading the whole order back to the caller and hearing a clear yes.",
      "parameters": {
        "type": "object",
        "properties": {
          "customer_name": { "type": "string" },
          "phone": { "type": "string", "description": "Digits only, confirmed with caller" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": { "type": "string" },
                "quantity": { "type": "integer" },
                "customization": { "type": "string", "description": "Flavor, size, cake message" }
              },
              "required": ["item", "quantity"]
            }
          },
          "pickup_time": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        },
        "required": ["customer_name", "phone", "items", "pickup_time"]
      },
      "execution_mode": "hold",
      "timeout_seconds": 15,
      "http": {
        "url": "${BACKEND_URL}/tools/create_order",
        "http_method": "POST",
        "headers": [{ "name": "X-Tool-Key", "value": "${TOOL_API_KEY}" }]
      }
    },
    {
      "name": "get_order_status",
      "description": "Look up an order the caller already placed, by its four digit order number. Returns the status, the items and the pickup time.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_id": { "type": "string", "description": "The four digit order number the caller reads out." }
        },
        "required": ["order_id"]
      },
      "execution_mode": "hold",
      "timeout_seconds": 10,
      "http": {
        "url": "${BACKEND_URL}/tools/get_order_status",
        "http_method": "POST",
        "headers": [{ "name": "X-Tool-Key", "value": "${TOOL_API_KEY}" }]
      }
    }
  ]
}
